# The Go every release is built with: the command line, the apps and the
# Docker image. scripts/release.sh builds with exactly this one (GOTOOLCHAIN)
# and refuses a binary made with another; the Dockerfiles default to it, and
# a test keeps them in step. Moving it on is a change here and in the two
# Dockerfiles' defaults (build/docker/Dockerfile, build/linux/Dockerfile).
GO_VERSION=1.26.11
