# The wacli the app ships with: one version, tested with the app, updated only
# by a new release of the app. The checksums are the ones openclaw/wacli
# publishes in that release's checksums.txt.
# Test builds (1.8.0-beta.2, macOS only): Bruno's fork, wacli 0.26.1 with the
# switch that stops asking the phone for undecryptable messages.
WACLI_REPO=BrOrlandi/wacli
WACLI_VERSION=0.26.1-orlandi.1
WACLI_SHA256_darwin_universal=c7616ed49834ed7ed68554a83dc5fb151d82b9e3a3a57615c02825640ac2bb59
WACLI_SHA256_darwin_arm64=20898523a70fb3ad992f8a20d786f70484bb53221df017cdafdcb7f7fc882d8f
WACLI_SHA256_darwin_amd64=d5561a41534ec83be8bca611d1fcef12bbfb9967a3661dcc7d0328b929224a7d
WACLI_SHA256_linux_amd64=515405c5a33c7f651a368484740db662736f50c275be5a0504fb0a84dce47013
WACLI_SHA256_linux_arm64=9efe789b01e12462140089749d8b5ce0ad292521893f4166e13eca81f0acac4c
WACLI_SHA256_windows_amd64=7b7f760db4ab6f25233e24316348fa6ddaeea9122e6fdf4335ba779f710a981e
